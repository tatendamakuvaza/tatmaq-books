# Copy to .env and fill in — never commit the real .env
# Signs sessions and shareable demo links. Generate with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
TATMAQ_SECRET=change-me-to-a-long-random-string

# Where the SQLite database lives (use a mounted volume path in production)
TATMAQ_DB=./tatmaq.db

# Port for local runs (gunicorn/Railway set this automatically)
PORT=5000
